# Copy to .env and adjust. All values are optional.

# Secret used to sign sessions. REQUIRED in production (use a long random string).
SECRET_KEY=change-me-to-a-long-random-string

# Database (default: SQLite file in database/sonicsentinel.db)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sonicsentinel

# Where uploaded audio and generated images are stored (default: data/storage)
# STORAGE_DIR=D:/sonicsentinel-storage

# Upload size limit per request in MB (the admin setting must be <= this)
MAX_UPLOAD_MB=30

# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=0
SESSION_HOURS=8

# Create the demo / evaluator accounts on first start (see README)
SEED_DEMO_USERS=1

# Pre-load the Python model at start-up so the first prediction is fast
WARMUP_MODELS=1

# Development server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
